# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=interview_coach_db
