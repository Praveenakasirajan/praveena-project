# ==============================================================================
# AI Interview Coach - Production-Ready Git Ignore Rules
# Ensures lightweight repository, zero leak of secrets, and seamless deployment
# ==============================================================================

# 1. Environment Secrets & Configs (NEVER COMMIT SENSITIVE API KEYS)
.env
*.env
.env.*
!.env.example

# 2. Python Virtual Environments
.venv/
venv/
.venv_old/
env/
ENV/
env.bak/
venv.bak/

# 3. Python Bytecode, Caches & Builds
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# 4. User Uploads, Resumes, and Generated Media (Prevents GitHub 25MB limit)
uploads/
uploads/**
test_artifacts/
*.webm
*.mp4
*.avi
*.mov
*.mkv
*.flv
*.wmv
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ogg
*.docx
*.pdf

# 5. Local Databases & SQLite Dumps
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# 6. AI Model Weights & Cache Files
.cache/
models_cache/
*.bin
*.pt
*.pth
*.onnx
huggingface/

# 7. Testing, Logs & Profiling
.pytest_cache/
.coverage
htmlcov/
*.log
test_opencv.py
voice_analyzer.py

# 8. IDE & Operating System Garbage Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# 9. Frontend Build Artifacts & Legacy Files
node_modules/
frontend/
.next/
out/
npm-debug.log*
yarn-debug.log*
